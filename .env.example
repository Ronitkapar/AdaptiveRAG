# AdaptiveRAG Environment Variables
# Copy to .env and populate with your credentials.
# NEVER commit .env to version control.

# --- AICredits (Embeddings) ---
# OpenAI-compatible embeddings gateway serving text-embedding-3-large
AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BATCH_SIZE=50
# EMBEDDING_DIMENSIONS=

# --- Groq (Generation & LLM Judge) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b

# --- Qdrant Vector Store (Local embedded by default) ---
QDRANT_MODE=local
QDRANT_PATH=storage/qdrant
QDRANT_COLLECTION=adaptiverag_dense_v1
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- Logging & Caching ---
LOG_LEVEL=INFO
# TIKTOKEN_CACHE_DIR=
