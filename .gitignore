# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.kilo/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Raw and processed large binaries / datasets
# Raw PDFs are reproducible via scripts/download_corpus.py
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Local storage and caches (Phase 2)
storage/
!storage/.gitkeep
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Experiments output runs (Phase 2)
experiments/*/
!experiments/.gitkeep
!experiments/README.md

# Stray SQLite session artifacts from an in-memory database literal path (Phase 7)
:memory:.ses

# Superseded phase 7 dataset build intermediates; the frozen dataset is
# data/evaluation/phase7_eval_v1.jsonl and its ledger (Phase 7)
data/evaluation/phase7_part_*.jsonl
data/evaluation/phase7_part_*.ledger.jsonl

# Phase 8 namespace corpora (the column-extraction before/after pair). Derived
# from the raw PDFs by the ingestion pipeline, so they are reproducible rather
# than committed; the intent matches `data/processed/*` above. Their exact
# versions are pinned by hash in docs/phase7-closure-evidence.md.
data/processed_phase8_before/
data/processed_phase8_after/

# IDEs & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
